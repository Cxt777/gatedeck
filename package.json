{
  "name": "gatedeck",
  "version": "0.1.0-rc.1",
  "description": "一休PM（Gatedeck）· 决策台优先、证据可校验的本地项目管理工具 — Know what's next. Prove what's done.",
  "type": "module",
  "license": "MIT",
  "private": false,
  "bin": {
    "gatedeck": "dist/cli/index.js",
    "pm": "dist/cli/index.js",
    "gatedeck-mcp": "dist/mcp/server.js"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "tag": "early",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cxt777/gatedeck.git"
  },
  "homepage": "https://github.com/Cxt777/gatedeck#readme",
  "bugs": {
    "url": "https://github.com/Cxt777/gatedeck/issues"
  },
  "keywords": [
    "pm",
    "project-management",
    "decision-deck",
    "mcp",
    "mcp-server",
    "ai-tools",
    "local-first",
    "markdown",
    "evidence-based",
    "solo-dev"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "tsc -p tsconfig.json",
    "prepublishOnly": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@types/node": "^22.20.5",
    "eslint": "^9.14.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.13.0",
    "vitest": "^2.1.4"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  }
}
